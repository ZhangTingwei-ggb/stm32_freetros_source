/**
  * @brief  Draw what is drawn only once: the title bar plus fixed labels
  */
static void UI_DrawStatic( void )
{
    LCD_Clear( LCD_COLOR_BG );

    /* Header bar. A dark panel on a black page has almost no visible edge, so
     * a hairline is drawn along the bottom of the bar to separate the two. */
    LCD_Fill( 0, 0, LCD_W - 1, UI_HDR_H - 1, LCD_COLOR_PANEL );
    LCD_Fill( 0, UI_HDR_H - 1U, LCD_W - 1, UI_HDR_H - 1U, LCD_COLOR_EDGE );
    LCD_ShowString( UI_TITLE_X, UI_TITLE_Y, "DHT11 MONITOR", LCD_COLOR_TITLE, LCD_COLOR_PANEL );

    /* Captions. On a 240 px wide screen the two blocks cannot sit side by
     * side ("TEMPERATURE" alone is 176 px), so they are stacked. */
    LCD_ShowString( UI_LBL_X, UI_TEMP_LBL_Y, "TEMPERATURE", LCD_COLOR_LABEL, LCD_COLOR_BG );
    LCD_ShowString( UI_LBL_X, UI_HUMI_LBL_Y, "HUMIDITY", LCD_COLOR_LABEL, LCD_COLOR_BG );

    /* Horizontal rules, one under each block */
    LCD_Fill( UI_DIV_X0, UI_DIV1_Y, UI_DIV_X1, UI_DIV1_Y + 1U, LCD_COLOR_EDGE );
    LCD_Fill( UI_DIV_X0, UI_DIV2_Y, UI_DIV_X1, UI_DIV2_Y + 1U, LCD_COLOR_EDGE );

    /* Placeholders, so the screen is not blank before the first sample.
     * Same 6-character width as the real readings, otherwise the digits
     * would not overwrite each other cleanly. */
    LCD_ShowStringScale( UI_VAL_X, UI_TEMP_VAL_Y, "--.-  ", LCD_COLOR_LABEL, LCD_COLOR_BG, UI_VAL_SCALE );
    LCD_ShowStringScale( UI_VAL_X, UI_HUMI_VAL_Y, "--.-  ", LCD_COLOR_LABEL, LCD_COLOR_BG, UI_VAL_SCALE );

    /* Exactly 12 characters, same as "Status: OK  " and "Status: ERR " below,
     * so all three states overwrite each other cleanly - and so the line ends
     * at x = 221, inside the 240 px screen. */
    LCD_ShowString( UI_STAT_X, UI_STAT_Y, "Status: WAIT", LCD_COLOR_WARN, LCD_COLOR_BG );
    LCD_Fill( UI_LED_X0, UI_LED_Y0, UI_LED_X1, UI_LED_Y1, LCD_COLOR_WARN );
}

/**
  * @brief  Sampling task
  * @note   DHT11_Init() calls vTaskDelay() internally, so it must be
  *         called after the scheduler has started (that is, from a task
  *         body); it cannot go in main().
  */
static void Dht11Task( void *argument )
{
    DHT11_Data_t data;

    ( void ) argument;

    DHT11_Init();           /* start DWT, pull the bus high, wait 1 s to
                             * get past the power-on unstable period */

    for( ;; )
    {
        /* A failed read is still forwarded, so the screen shows an error state
         * instead of freezing on the last good value */
        if( DHT11_Read( &data ) == 0U )
        {
            data.humi_int = 0U;
            data.humi_dec = 0U;
            data.temp_int = 0U;
            data.temp_dec = 0U;
            data.valid    = 0U;
        }

        /* Push into the queue. Length is 1 and we use Overwrite, so this
         * call can never block. */
        xQueueOverwrite( dhtQueue, &data );

        vTaskDelay( pdMS_TO_TICKS( DHT11_PERIOD_MS ) );
    }
}

/**
  * @brief  Display task: block on the queue, refresh whenever data arrives
  */
static void LcdTask( void *argument )
{
    DHT11_Data_t data;
    char buf[ 16 ];         /* longest string is "ERR:12345" = 9 characters */
    uint32_t okCnt  = 0U;
    uint32_t errCnt = 0U;

    ( void ) argument;

    LCD_Init();             /* FSMC must already have been configured by
                             * MX_FSMC_Init() */
    UI_DrawStatic();

    for( ;; )
    {
        /* Block here while there is no data: costs no CPU */
        if( xQueueReceive( dhtQueue, &data, portMAX_DELAY ) != pdPASS )
        {
            continue;
        }

        if( data.valid != 0U )
        {
            okCnt++;

            /* "%2d.%d C" is always exactly 6 characters (" 9.5 C" as well as
             * "23.5 C"), so redrawing it over the previous value leaves
             * nothing behind and no padding is needed. */
            snprintf( buf, sizeof( buf ), "%2d.%d C", data.temp_int, data.temp_dec );
            LCD_ShowStringScale( UI_VAL_X, UI_TEMP_VAL_Y, buf, LCD_COLOR_TEMP, LCD_COLOR_BG, UI_VAL_SCALE );

            snprintf( buf, sizeof( buf ), "%2d.%d %%", data.humi_int, data.humi_dec );
            LCD_ShowStringScale( UI_VAL_X, UI_HUMI_VAL_Y, buf, LCD_COLOR_HUMI, LCD_COLOR_BG, UI_VAL_SCALE );

            LCD_ShowString( UI_STAT_X, UI_STAT_Y, "Status: OK  ", LCD_COLOR_OK, LCD_COLOR_BG );
            LCD_Fill( UI_LED_X0, UI_LED_Y0, UI_LED_X1, UI_LED_Y1, LCD_COLOR_OK );
        }
        else
        {
            errCnt++;

            /* Same 6-character width as a real reading, so the error text
             * erases the value instead of leaving a stray digit behind */
            LCD_ShowStringScale( UI_VAL_X, UI_TEMP_VAL_Y, "--.-  ", LCD_COLOR_ERR, LCD_COLOR_BG, UI_VAL_SCALE );
            LCD_ShowStringScale( UI_VAL_X, UI_HUMI_VAL_Y, "--.-  ", LCD_COLOR_ERR, LCD_COLOR_BG, UI_VAL_SCALE );

            LCD_ShowString( UI_STAT_X, UI_STAT_Y, "Status: ERR ", LCD_COLOR_ERR, LCD_COLOR_BG );
            LCD_Fill( UI_LED_X0, UI_LED_Y0, UI_LED_X1, UI_LED_Y1, LCD_COLOR_ERR );
        }

        /* One counter per line. "%-5lu" is only a MINIMUM width, so a longer
         * count would grow the string and push it past the right edge, where
         * the address counter wraps it back to the left as garbage. The screen
         * therefore shows at most 99999; the real counters keep running. */
        snprintf( buf, sizeof( buf ), "OK:%-5lu",  ( okCnt  > 99999UL ) ? 99999UL : okCnt );
        LCD_ShowString( UI_CNT_X, UI_CNT1_Y, buf, LCD_COLOR_MUTED, LCD_COLOR_BG );

        snprintf( buf, sizeof( buf ), "ERR:%-5lu", ( errCnt > 99999UL ) ? 99999UL : errCnt );
        LCD_ShowString( UI_CNT_X, UI_CNT2_Y, buf, LCD_COLOR_MUTED, LCD_COLOR_BG );
    }
}

