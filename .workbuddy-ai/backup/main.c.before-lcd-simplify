/* Task stack depth is counted in words: 256 * 4 = 1 KB.
 * LcdTask calls snprintf, so it eats more stack than the plain GPIO
 * tasks; 256 leaves a comfortable margin. */
#define TASK_STACK_DEPTH        256U

/* Priorities: the sampling task sits above the display task.
 * Both tasks are driven by "read from / write to the queue", so
 * letting the sampler run first guarantees no sample is dropped. */
#define DHT11_TASK_PRIO         3U
#define LCD_TASK_PRIO           2U

/* The DHT11 datasheet asks for >= 1 s between samples; we use 2 s,
 * which makes the sensor more stable */
#define DHT11_PERIOD_MS         2000U

/* ---------------------------------------------------------------------------
 * UI geometry - PORTRAIT 240 x 320
 * ---------------------------------------------------------------------------
 *   +------------------------+  0
 *   |     DHT11 MONITOR      |  blue header, 29 px, title centred
 *   +------------------------+  29
 *   |  TEMPERATURE           |  40  caption, native 16x24 font
 *   |  23.5 C                |  72  reading, 2x font (32 x 48 per char)
 *   |  --------------------- |  132 rule
 *   |  HUMIDITY              |  144 caption
 *   |  45.0 %                |  176 reading, 2x font
 *   |  --------------------- |  236 rule
 *   |  [] Status: OK         |  244 status square + text
 *   |  OK:12                 |  272 counter, one line each
 *   |  ERR:0                 |  296 counter
 *   +------------------------+  320
 *
 * Widths matter on a 240 px screen: the native font is 16 px per character,
 * so a line holds only 15 of them, and the 2x font is 32 px per character.
 * Every string is a FIXED width, so redrawing never leaves leftovers, and
 * none of them may end past x = 239:
 *   "DHT11 MONITOR"  = 13 chars = 208 px  (x = 16 .. 223)
 *   "TEMPERATURE"    = 11 chars = 176 px  (x = 12 .. 187)
 *   "HUMIDITY"       =  8 chars = 128 px  (x = 12 .. 139)
 *   "23.5 C"         =  6 chars = 192 px  (x = 12 .. 203, drawn with the 2x font)
 *   "Status: WAIT"   = 12 chars = 192 px  (x = 30 .. 221)
 *   "Status: OK  "   = 12 chars = 192 px  (x = 30 .. 221)
 *   "Status: ERR "   = 12 chars = 192 px  (x = 30 .. 221)
 *   "OK:12345"       =  8 chars = 128 px  (x = 12 .. 139)
 *   "ERR:12345"      =  9 chars = 144 px  (x = 12 .. 155)
 * The counters are clamped to 99999 - see the note in LcdTask(); "%-5lu" is
 * only a MINIMUM width, so without the clamp a longer count would push the
 * text past the right edge and the address counter would wrap it to the left.
 * ------------------------------------------------------------------------- */
#define UI_HDR_H        29U     /* blue header bar                        */
#define UI_TITLE_X      16U     /* centres the 13-char title in 240 px    */
#define UI_TITLE_Y      2U

#define UI_LBL_X        12U     /* captions, native font                  */
#define UI_TEMP_LBL_Y   40U
#define UI_HUMI_LBL_Y   144U

#define UI_VAL_X        12U     /* readings, 2x font                      */
#define UI_VAL_SCALE    2U
#define UI_TEMP_VAL_Y   72U
#define UI_HUMI_VAL_Y   176U

#define UI_DIV_X0       12U     /* rules                                  */
#define UI_DIV_X1       227U
#define UI_DIV1_Y       132U
#define UI_DIV2_Y       236U

#define UI_LED_X0       12U     /* status square, left of the status text */
#define UI_LED_Y0       250U
#define UI_LED_X1       23U
#define UI_LED_Y1       261U

#define UI_STAT_X       30U
#define UI_STAT_Y       244U

/* One line per counter. Sharing a line does not work here: "OK:1234" plus
 * "ERR:1234" is 15 characters = 240 px, which fills the whole screen with no
 * gap and no margin, and the error counter alone needs 8 characters - placed
 * at x = 128 that ends at 255 and wraps. Stacked, both keep the same 12 px
 * left margin as every other row and still leave room for 5 digits. */
#define UI_CNT_X        12U
#define UI_CNT1_Y       272U
#define UI_CNT2_Y       296U

/* This layout is drawn for a 240x320 canvas. On this panel that is the MV=1
 * pair (see the measurement table in lcd.h), so the guard below catches a
 * switch to the 320x240 pair instead of silently letting the UI overflow. */
#if ( LCD_W > LCD_H )
#error "This UI is built for the 240x320 canvas. Set LCD_MADCTL to LCD_MADCTL_MV1_MX0_MY1 or LCD_MADCTL_MV1_MX1_MY0 in Core/BSP/lcd.h."
#endif
